# OpenAI API 키 (필수)
OPENAI_API_KEY=sk-여기에-키-입력

# 사용할 챗 모델 (provider:model 형식, 이미지 입력 지원 모델이어야 함)
FITCAST_MODEL=openai:gpt-4o-mini

# 임베딩 모델 (스타일 가이드 RAG용)
FITCAST_EMBEDDING_MODEL=openai:text-embedding-3-small

# 샘플링 온도 (비워두면 모델 기본값 사용)
FITCAST_TEMPERATURE=0.7

# 기본 도시
FITCAST_DEFAULT_CITY=서울

# 실제 상품 검색: SerpApi(구글 쇼핑)가 있으면 우선 사용 https://serpapi.com/manage-api-key
SERPAPI_KEY=

# 또는 네이버 쇼핑 검색 API (둘 다 비워두면 기본 썸네일)
# https://developers.naver.com/apps/#/register 에서 '검색' API로 애플리케이션 등록
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# AI 피팅 보기에 쓸 이미지 편집 모델 (OPENAI_API_KEY 사용)
FITCAST_IMAGE_MODEL=gpt-image-1

# 상품 검색 결과에서 '사람 없이 상품만 찍힌 사진'을 골라내는 비전 모델 (gpt-4o-mini는 타일 번호를 자주 틀림)
FITCAST_VISION_MODEL=gpt-4o
